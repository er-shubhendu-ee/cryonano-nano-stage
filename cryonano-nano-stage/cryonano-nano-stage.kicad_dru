(version 3)

# ==========================================================
# VIA POLICY
# ==========================================================

(rule "Via policy: Through vias only"
	(condition "A.Via_Type == 'Micro' || A.Via_Type == 'Blind/buried'")
	(constraint disallow)
)

# ==========================================================
#	Via rules
# ==========================================================

# PREVENT SOLDER WICKING (NO VIA-IN-PAD)
(rule "Via-in-pad: No holes in small pads"
    (condition "B.Size_X < 1.5mm && B.Size_Y < 1.5mm && B.Pad_Type == 'SMD'")
	(constraint physical_hole_clearance ( min 0.03mm))
)

# VIA HOLE TO HOLE CLEARANCES
(rule "Via: Via hole to track clearance, inner layer"
	(layer inner)
    (condition "A.Type == 'Via' && B.Type == 'Track'")
    (constraint hole_clearance (min 0.3mm))
)

# VIA HOLE TO COPPER CLEARENCE
(rule "Via: Via hole to copper (non-track), inner layer"
	(layer inner)
    (condition "A.Type == 'Via' && !B.Type == 'Track'")
    (constraint hole_clearance (min 0.25mm))
)

(rule "Via: Via hole to copper, outer layer"
	(layer outer)
    (condition "A.Type == 'Via' && B.Type == '*'")
    (constraint hole_clearance (min 0.125mm))
)

# ==========================================================
# BASE COPPER CLEARANCE (INNER, NON-ZONE)
# ==========================================================

(rule "Base copper clearence: Copper to Copper Clearance, inner layer"
	(severity error)
	(layer inner)
	(condition " !(A.Type=='Zone' || B.Type=='Zone' || A.inDiffPair('*') || B.inDiffPair('*'))")
	(constraint clearance (min 0.125mm))
)

# ==========================================================
# HOLE TO HOLE CLEARANCE
# ==========================================================

(rule "Hole: Hole to hole clearance"
	(severity error)
	(constraint hole_to_hole (min 0.25mm))
)

# ==========================================================
# BGA FANOUT RULES
# ==========================================================

(rule "FANOUT: BGA Signal"
	(condition "(A.enclosedByArea('BGA_AREA') || B.enclosedByArea('BGA_AREA')) && (A.NetClass != 'Power_LV' || B.NetClass != 'Power_LV') && !(A.inDiffPair('*') || B.inDiffPair('*'))")
	(constraint via_diameter (min 0.7mm) (opt 0.7mm) (max 0.7mm))
	(constraint hole_size (min 0.35mm) (opt 0.35mm) (max 0.35mm))
	(constraint track_width (min 0.16mm) (opt 0.16mm))
	(constraint clearance (min 0.125mm) (opt 0.125mm))
)

(rule "FANOUT: BGA Power"
	(condition "(A.enclosedByArea('BGA_AREA') || B.enclosedByArea('BGA_AREA'))&& (A.NetClass == 'Power_LV' || B.NetClass == 'Power_LV')")
	(constraint via_diameter (min 0.7mm) (opt 0.7mm) (max 0.7mm))
	(constraint hole_size (min 0.35mm) (opt 0.35mm) (max 0.35mm))
	(constraint track_width (min 0.2mm) (opt 0.25mm))
	(constraint clearance (min 0.2mm) (opt 0.25mm))
)

(rule "FANOUT: BGA Via clearence."
	(condition "(A.enclosedByArea('BGA_AREA') || B.enclosedByArea('BGA_AREA'))&& (A.Type == 'Via' || B.Type == 'Via')")
	(constraint track_width (min 0.1mm) (opt 0.125mm))
	(constraint clearance (min 0.35mm))
)


# =============
# USB CONNECTOR FANOUT
# ==================

(rule "FANOUT: USB Connector clearence."
	(condition "(A.enclosedByArea('USB_AREA') || B.enclosedByArea('USB_AREA'))&& (A.Type == 'Pad' || B.Type == 'Pad')")
	(constraint clearance (min 0.05mm))
)

# ==========================================================
# LOW VOLTAGE ZONE (LV_ZONE, <=50V)
# Zone copper clearance must be set LOW (e.g. 0.125mm)
# ==========================================================

# Objects fully enclosed in LV_ZONE
(rule "LV_ZONE: LV zone clearance inner enclosed"
	(severity error)
	(layer inner)
	(condition "A.enclosedByArea('LV_ZONE') || B.enclosedByArea('LV_ZONE')")
	(constraint clearance (min 0.4mm))
)

(rule "LV_ZONE: LV zone clearance outer enclosed"
	(severity error)
	(layer outer)
	(condition "A.enclosedByArea('LV_ZONE') || B.enclosedByArea('LV_ZONE')")
	(constraint clearance (min 0.3mm))
)

# Objects intersecting LV_ZONE boundary
(rule "LV_ZONE: LV zone clearance inner intersect"
	(severity error)
	(layer inner)
	(condition "A.intersectsArea('LV_ZONE') || B.intersectsArea('LV_ZONE')")
	(constraint clearance (min 0.4mm))
)

(rule "LV_ZONE: LV zone clearance outer intersect"
	(severity error)
	(layer outer)
	(condition "A.intersectsArea('LV_ZONE') || B.intersectsArea('LV_ZONE')")
	(constraint clearance (min 0.3mm))
)


# ==========================================================
# HIGH VOLTAGE ZONE (HV_ZONE, <=600V)
# ==========================================================
(rule "HV_ZONE: HV zone clearance outer enclosed pad to others"
	(severity error)
	(layer inner)
	(condition "(A.NetClass == 'HV_NET' || B.NetClass == 'HV_NET') && (A.enclosedByArea('HV_ZONE') || B.enclosedByArea('HV_ZONE'))")
	(constraint clearance (min 2.5mm))
)

(rule "HV_ZONE: HV zone clearance outer enclosed pad to connector"
	(severity error)
	(layer inner)
	(condition "(A.NetClass == 'HV_NET' || B.NetClass == 'HV_NET') && (A.enclosedByArea('HV_ZONE') || B.enclosedByArea('HV_ZONE')) && (A.Type == 'Pad' && B.Type == 'Pad')")
	(constraint clearance (min 2.0mm))
)

(rule "HV_ZONE: HV zone clearance inner enclosed, connector pin to HV_ZONE"
	(severity error)
	(layer inner)
	(condition "((A.Name != 'HV_ZONE') || (B.Name != 'HV_ZONE')) && (A.enclosedByArea('HV_ZONE_CONNECTOR') || B.enclosedByArea('HV_ZONE_CONNECTOR'))")
	(constraint clearance (min 2.5mm))
)

(rule "CR: HV zone clearance inner enclosed, connector pin to others"
	(severity error)
	(layer inner)
	(condition "((A.Name == 'HV_ZONE') || (B.Name == 'HV_ZONE')) && (A.enclosedByArea('HV_ZONE_CONNECTOR') || B.enclosedByArea('HV_ZONE_CONNECTOR'))")
	(constraint clearance (min 2.0mm))
)


(rule "HV_ZONE: HV zone clearance outer enclosed, non-pad to others"
	(severity error)
	(layer outer)
	(condition "(A.Name != B.Name) && ((A.Type != 'Pad' && A.enclosedByArea('HV_ZONE')) || (B.Type != 'Pad' && B.enclosedByArea('HV_ZONE')))")
	(constraint clearance (min 3.0mm))
)

(rule "HV_ZONE: HV zone clearance outer enclosed pad to others"
	(severity error)
	(layer outer)
	(condition "(A.Type == 'Pad' && A.enclosedByArea('HV_ZONE')) || (B.Type == 'Pad' && B.enclosedByArea('HV_ZONE'))")
	(constraint clearance (min 2.0mm))
)



# ==========================================================
# HV_LV_EXCLUSION ZONE
# Purpose:
# - Acts as an LV-behavior routing island inside HV_ZONE
# - Allows dense routing inside HV areas
# - Overrides HV clearance locally by higher specificity
# - Uses BOTH enclosed and intersect rules:
#   * enclosedByArea()  -> primary (clean domain override)
#   * intersectsArea()  -> secondary (boundary policing)
# ==========================================================

# ----------------------------------------------------------
# Primary rule: objects fully inside HV_LV_EXCLUSION
# Treated as LV domain (highest specificity)
# ----------------------------------------------------------

# HV_LV_EXCLUSION Via
(rule "HV_LV_EXCLUSION: HV_LV_EXCLUSION inner non-via"
	(severity error)
	(layer inner)
	(condition "(A.Type!='Via' && A.enclosedByArea('HV_LV_EXCLUSION')) || (B.Type!='Via' && B.enclosedByArea('HV_LV_EXCLUSION'))")
	(constraint clearance (min 0.125mm))
)


(rule "HV_LV_EXCLUSION: HV_LV_EXCLUSION F.Cu non-via"
	(severity error)
	(layer outer)
	(condition "(A.Type!='Via' && A.enclosedByArea('HV_LV_EXCLUSION')) || (B.Type!='Via' && B.enclosedByArea('HV_LV_EXCLUSION'))")
	(constraint clearance (min 0.2mm))
)

(rule "CR: HV_LV_EXCLUSION non-zone"
	(severity error)
	(condition "(((A.Type == 'Via' && B.Type != 'Zone') || (B.Type == 'Via' && A.Type != 'Zone')) && (A.enclosedByArea('HV_LV_EXCLUSION') || B.enclosedByArea('HV_LV_EXCLUSION')))")
	(constraint clearance (min 0.2mm))
)

## ==========================================================
(rule "HV_LV_EXCLUSION: HV_LV_EXCLUSION HV_NET"
	(severity error)
    (layer outer)
	(condition "(A.NetClass == 'HV_NET' && B.NetClass == 'HV_NET') && (A.enclosedByArea('HV_ZONE') || B.enclosedByArea('HV_ZONE'))")
	(constraint clearance (min 3.0mm))
)

(rule "HV_LV_EXCLUSION: HV_LV_EXCLUSION HV_NET"
	(severity error)
    (layer inner)
	(condition "(A.NetClass == 'HV_NET' && B.NetClass == 'HV_NET') && (A.enclosedByArea('HV_ZONE') || B.enclosedByArea('HV_ZONE'))")
	(constraint clearance (min 2.5mm))
)

(rule "HV_LV_EXCLUSION: HV_ISOL, outer"
	(severity error)
	(layer outer)
	(condition "(A.enclosedByArea('HV_ISOL') || B.enclosedByArea('HV_ISOL')) && (A.Type == 'Zone' && B.Type == 'Zone')")
	(constraint clearance (min 3.0mm))
)

(rule "HV_LV_EXCLUSION: HV_ISOL, inner"
	(severity error)
	(layer inner)
	(condition "(A.enclosedByArea('HV_ISOL') || B.enclosedByArea('HV_ISOL')) && (A.Type == 'Zone' && B.Type == 'Zone')")
	(constraint clearance (min 2.5mm))
)

(rule "HV_LV_EXCLUSION: NO_ISOL"
	(severity error)
	(condition "(A.enclosedByArea('NO_ISOL') || B.enclosedByArea('NO_ISOL')) && (A.Type == 'Zone' && B.Type == 'Zone')")
	(constraint clearance (min 0.6mm))
)

## ==========================================================
## HV TO LV ISOLATION (BOUNDARY-AWARE)
