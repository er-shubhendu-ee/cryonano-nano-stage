# ==========================================================
# MANUFACTURING RULESET - PCB POWER (RIGID PCB)
# Source: PCB Power - Technical Capabilities (Rigid PCB)
# Scope: Additive manufacturability constraints only
# ==========================================================
# ----------------------------------------------------------
# VIA & DRILL MANUFACTURABILITY
# ----------------------------------------------------------

(rule "FAB/DRILL: Minimum finished drill size"
	(severity error)
	(constraint hole_size (min 0.10mm) (max 5.0mm))
)


(rule "FAB/ANNULAR-RING: Minimum annular ring"
	(severity error)
	(constraint annular_width (min 0.10mm))
)


(rule "FAB/COPPER TO COPPER: Via hole to copper clearance (inner)"
	(severity error)
	(layer inner)
	(constraint hole_clearance (min 0.20mm))
)


# MECHANICAL / BOARD EDGE

(rule "FAB/BOARD EDGE: Copper to board edge clearance"
	(severity error)
	(constraint edge_clearance (min 0.20mm))
)


# SOLDER MASK MANUFACTURABILITY

#(rule "FAB/MASK: Min silk to copper spacing"
#	(severity error)
#	(constraint silk_clearance (min 0.08mm))
#)


