	(gr_text "Stack-Up Details(As derived from lioncircuits website data):\n\nLayer count = 4\nNominal finished board thickness = 1.6 mm(Approx.)\nDielectric model: εr = 4.3, Df/tanδ = 0.02, based on standard FR-4/2116 material data\nImpedance calculations: 1 GHz nominal"
		(at 150 50 0)
		(layer "F.Fab")
		(uuid "0ae1662d-1875-4883-a346-1db8cbb848f1")
		(effects
			(font
				(size 0.8 0.7)
				(thickness 0.16)
			)
			(justify left bottom)
		)
	)
	(gr_text "Note:\n	1. Via has no pad on unconnected layers.\n	2. Standard buildup as per manufacturer website data.\n	3. Nominal board thickness: ~1.6 mm; individual layer thicknesses are approximate.\n	4. Impedance calculations based on εr = 4.3, tanδ = 0.02 at 1 GHz.\n	5. Impedance values are calculated nominal values and are not impedance-controlled specifications.\n	6. L1/L4 high-speed signals shall reference the adjacent continuous L2/L3 GND plane.\n	7. Differential pairs shall maintain their specified width/spacing and avoid reference-plane discontinuities.\n	8. Target: 60 Ω nominal; Microchip reference recommendation: 68 Ω."
		(at 150 116.3 0)
		(layer "F.Fab")
		(uuid "41cf5586-89d8-47ef-ad04-698d408420dc")
		(effects
			(font
				(size 0.8 0.7)
				(thickness 0.16)
			)
			(justify left bottom)
		)
	)
